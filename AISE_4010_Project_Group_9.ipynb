      "source": [
        "final, run_log, test_preds, curves = {}, [], {}, {}\n",
        "for name in GRIDS:\n",
        "    cfg, L = BEST[name], BEST[name][\"window\"]; per_seed = []\n",
        "    for s in FINAL_SEEDS:\n",
        "        r = run_config(name, cfg, s); pt = inv(predict_scaled(r[\"model\"], tens(L, \"test\")[0])); mt = metrics(Y_test, pt)\n",
        "        per_seed.append(dict(seed=s, params=r[\"params\"], train_s=r[\"train_time\"], epochs=r[\"epochs\"],\n",
        "                             **{f\"val_{k}\": v for k, v in r[\"val\"].items()}, **{f\"test_{k}\": v for k, v in mt.items()}))\n",
        "        if s == SEED: test_preds[name] = pt; curves[name] = r[\"hist\"]\n",
        "        run_log.append(dict(model=name, cfg=cfg, **per_seed[-1]))\n",
        "    final[name] = pd.DataFrame(per_seed); print(name, \"done\"); display(final[name].round(3))\n",
        "\n",
        "def agg(df_, col): return df_[col].mean(), df_[col].std(ddof=0)\n",
        "rows = []\n",
        "for k in base:\n",
        "    mv, mt = metrics(Y_val, base[k][\"val\"]), metrics(Y_test, base[k][\"test\"])\n",
        "    rows.append(dict(Model=k, Config=\"—\", Params=0, Train_s=0.0, Seeds=\"—\", val_MAE=mv[\"MAE\"], **{f\"test_{m}\": mt[m] for m in mt}, test_MAE_std=0.0, test_RMSE_std=0.0))\n",
        "mv, mt = metrics(Y_val, ridge_pred[\"val\"]), metrics(Y_test, ridge_pred[\"test\"])\n",
        "rows.append(dict(Model=\"Ridge (linear ref.)\", Config=f\"L={R_L}, alpha={R_ALPHA}\", Params=ridge_params, Train_s=ridge_time, Seeds=\"deterministic\",\n",
        "                 val_MAE=mv[\"MAE\"], **{f\"test_{m}\": mt[m] for m in mt}, test_MAE_std=0.0, test_RMSE_std=0.0))\n",
        "for name, f in final.items():\n",
        "    rows.append(dict(Model=name, Config=str(BEST[name]), Params=int(f.params.iloc[0]), Train_s=f.train_s.mean(), Seeds=str(FINAL_SEEDS),\n",
        "                     val_MAE=f.val_MAE.mean(), **{f\"test_{m}\": f[f\"test_{m}\"].mean() for m in (\"MAE\", \"RMSE\", \"sMAPE\", \"R2\")},\n",
        "                     test_MAE_std=f.test_MAE.std(ddof=0), test_RMSE_std=f.test_RMSE.std(ddof=0)))\n",
        "cmp_ = pd.DataFrame(rows)\n",
        "cmp_[\"MAE_improv_%\"]  = 100 * (BASE_TEST[\"MAE\"]  - cmp_[\"test_MAE\"])  / BASE_TEST[\"MAE\"]\n",
        "cmp_[\"RMSE_improv_%\"] = 100 * (BASE_TEST[\"RMSE\"] - cmp_[\"test_RMSE\"]) / BASE_TEST[\"RMSE\"]\n",
        "cmp_.to_csv(\"results/comparison_table.csv\", index=False)\n",
        "json.dump(dict(env=ENV, seed=SEED, final_seeds=FINAL_SEEDS, horizon=HORIZON, runs=run_log), open(\"results/run_log.json\", \"w\"), indent=1, default=float)\n",
        "print(\"TEST-SET COMPARISON (original units, Wh; same 3,947 test instances for every model)\")\n",
        "display(cmp_.drop(columns=[\"Config\"]).round(3))"
      ]
    },
