        "import os, time, json, random, itertools, platform, warnings\n",
        "import numpy as np, pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "import torch, torch.nn as nn\n",
        "import sklearn\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.impute import SimpleImputer\n",
        "from sklearn.linear_model import Ridge\n",
        "warnings.filterwarnings(\"ignore\")\n",
        "sns.set_theme(style=\"whitegrid\", context=\"notebook\")\n",
        "pd.set_option(\"display.width\", 200, \"display.max_columns\", 50)\n",
        "\n",
        "# ---------------- CONFIG (identical for every model) ----------------\n",
        "QUICK = os.environ.get(\"QUICK\", \"0\") == \"1\"      # smoke-test mode\n",
        "SEED = 42\n",
        "HORIZON = 1                                       # predict y[t+HORIZON] from window ending at t\n",
        "LOOKBACKS = [18, 36, 72]                          # candidate window lengths (3h, 6h, 12h)\n",
        "MAXW = max(LOOKBACKS)                             # fixed so train/val/test targets are identical for all windows\n",
        "TRAIN_FRAC, VAL_FRAC = 0.60, 0.20\n",
        "BATCH, MAX_EPOCHS, PATIENCE, WD = 256, 60, 8, 1e-5\n",
        "FINAL_SEEDS = [42, 43, 44, 45, 46]\n",
        "DAY = 144                                         # 144 ten-minute steps = 1 day\n",
        "if QUICK:\n",
        "    MAX_EPOCHS, FINAL_SEEDS = 5, [42, 43]\n",
        "\n",
        "DEVICE = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
        "def set_seed(s):\n",
        "    random.seed(s); np.random.seed(s); torch.manual_seed(s)\n",
        "    if torch.cuda.is_available(): torch.cuda.manual_seed_all(s)\n",
        "    torch.backends.cudnn.deterministic = True; torch.backends.cudnn.benchmark = False\n",
        "set_seed(SEED)\n",
        "os.makedirs(\"results\", exist_ok=True)\n",
        "ENV = dict(python=platform.python_version(), torch=torch.__version__, sklearn=sklearn.__version__,\n",
        "           numpy=np.__version__, pandas=pd.__version__, device=str(DEVICE), quick=QUICK)\n",
        "print(ENV)"
      ]
    },
