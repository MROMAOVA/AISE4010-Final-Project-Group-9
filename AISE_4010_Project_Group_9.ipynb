      "source": [
        "CSV = \"energydata_complete.csv\"\n",
        "if not os.path.exists(CSV):\n",
        "    try:\n",
        "        from google.colab import files\n",
        "        print(\"Please upload energydata_complete.csv\"); files.upload()\n",
        "    except ImportError:\n",
        "        raise FileNotFoundError(\"Place energydata_complete.csv next to this notebook.\")\n",
        "df = pd.read_csv(CSV, parse_dates=[\"date\"]).sort_values(\"date\").reset_index(drop=True)\n",
        "n = len(df)\n",
        "step = pd.Timedelta(minutes=10)\n",
        "diffs = df[\"date\"].diff().dropna()\n",
        "expected_rows = int((df[\"date\"].max() - df[\"date\"].min()) / step) + 1\n",
        "audit = pd.Series({\n",
        "    \"Source\": \"UCI ML Repository — Appliances Energy Prediction (Candanedo et al., 2017); house in Stambruges, Belgium\",\n",
        "    \"Target\": \"Appliances — appliance energy use, Wh per 10-minute interval\",\n",
        "    \"Native frequency\": f\"{diffs.mode()[0]} (median step {diffs.median()})\",\n",
        "    \"Resampling rule\": \"None (data already regular at 10 min)\",\n",
        "    \"Coverage\": f\"{df['date'].min()}  →  {df['date'].max()}  ({(df['date'].max()-df['date'].min()).days} days)\",\n",
        "    \"Rows\": n,\n",
        "    \"Expected rows if complete\": expected_rows,\n",
        "    \"Gaps (steps != 10 min)\": int((diffs != step).sum()),\n",
        "    \"Duplicated timestamps\": int(df[\"date\"].duplicated().sum()),\n",
        "    \"Fully duplicated rows\": int(df.duplicated().sum()),\n",
        "    \"Missing values (all cols)\": int(df.isna().sum().sum()),\n",
        "    \"Monotonic timestamps\": bool(df[\"date\"].is_monotonic_increasing),\n",
        "})\n",
        "display(audit.to_frame(\"value\"))\n",
        "display(df.drop(columns=\"date\").describe().T.round(2))"
      ]
    },
