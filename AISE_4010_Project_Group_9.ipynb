      "source": [
        "## 6. Neural models (MLP and 1D-CNN)\n",
        "Both receive **exactly the same window tensor** `(L, C)`: the MLP flattens it, the CNN treats it as `C` channels over `L` time steps. Same loss (Huber), optimiser (Adam), batch size, max epochs, early-stopping rule (patience on validation loss, best weights restored), metrics and data.\n",
        "\n",
        "*Note on shuffling:* mini-batches are shuffled **inside the training split** only (standard SGD); the split itself stays chronological and no val/test information is used."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 9,
      "id": "81247237",
      "metadata": {
        "id": "81247237"
      },
      "outputs": [],
      "source": [
        "class MLP(nn.Module):\n",
        "    def __init__(s, L, C, hidden, dropout):\n",
        "        super().__init__()\n",
        "        s.net = nn.Sequential(nn.Flatten(), nn.Linear(L*C, hidden), nn.ReLU(), nn.Dropout(dropout),\n",
        "                              nn.Linear(hidden, hidden//2), nn.ReLU(), nn.Dropout(dropout), nn.Linear(hidden//2, 1))\n",
        "    def forward(s, x): return s.net(x).squeeze(-1)\n",
        "\n",
        "class CNN1D(nn.Module):\n",
        "    def __init__(s, L, C, filters, kernel, dropout):\n",
        "        super().__init__()\n",
        "        p = kernel // 2\n",
        "        s.conv = nn.Sequential(nn.Conv1d(C, filters, kernel, padding=p), nn.ReLU(), nn.MaxPool1d(2),\n",
        "                               nn.Conv1d(filters, 2*filters, kernel, padding=p), nn.ReLU(), nn.AdaptiveAvgPool1d(4))\n",
        "        s.head = nn.Sequential(nn.Flatten(), nn.Linear(2*filters*4, 64), nn.ReLU(), nn.Dropout(dropout), nn.Linear(64, 1))\n",
        "    def forward(s, x): return s.head(s.conv(x.transpose(1, 2))).squeeze(-1)    # (B,L,C) -> (B,C,L)\n",
        "\n",
        "def build(name, cfg):\n",
        "    L = cfg[\"window\"]\n",
        "    return (MLP(L, C, cfg[\"hidden\"], cfg[\"dropout\"]) if name == \"MLP\" else CNN1D(L, C, cfg[\"filters\"], cfg[\"kernel\"], cfg[\"dropout\"])).to(DEVICE)\n",
        "n_params = lambda m: sum(p.numel() for p in m.parameters())\n",
        "\n",
        "_tens = {}\n",
        "def tens(L, split):\n",
        "    if (L, split) not in _tens:\n",
        "        d = get_data(L)[split]; _tens[(L, split)] = (torch.from_numpy(d[\"X\"]).to(DEVICE), torch.from_numpy(d[\"y\"]).to(DEVICE))\n",
        "    return _tens[(L, split)]\n",
        "\n",
        "@torch.no_grad()\n",
        "def predict_scaled(model, X, bs=2048):\n",
        "    model.eval(); return torch.cat([model(X[i:i+bs]) for i in range(0, len(X), bs)]).cpu().numpy()\n",
        "\n",
        "def fit(model, L, lr, seed):\n",
        "    set_seed(seed)\n",
        "    Xtr, ytr = tens(L, \"train\"); Xva, yva = tens(L, \"val\")\n",
        "    opt = torch.optim.Adam(model.parameters(), lr=lr, weight_decay=WD); lossf = nn.HuberLoss(delta=1.0)\n",
        "    g = torch.Generator().manual_seed(seed); best, best_state, bad, hist = float(\"inf\"), None, 0, []\n",
        "    t0 = time.time()\n",
        "    for ep in range(MAX_EPOCHS):\n",
        "        model.train(); perm = torch.randperm(len(Xtr), generator=g)\n",
        "        tl = 0.0\n",
        "        for i in range(0, len(perm), BATCH):\n",
        "            idx = perm[i:i+BATCH].to(DEVICE); opt.zero_grad()\n",
        "            loss = lossf(model(Xtr[idx]), ytr[idx]); loss.backward(); opt.step(); tl += loss.item() * len(idx)\n",
        "        with torch.no_grad(): vl = lossf(torch.from_numpy(predict_scaled(model, Xva)).to(DEVICE), yva).item()\n",
        "        hist.append((tl/len(perm), vl))\n",
        "        if vl < best - 1e-5: best, bad, best_state = vl, 0, {k: v.detach().clone() for k, v in model.state_dict().items()}\n",
        "        else:\n",
        "            bad += 1\n",
        "            if bad >= PATIENCE: break\n",
        "    model.load_state_dict(best_state)\n",
        "    return time.time() - t0, hist\n",
        "\n",
        "def run_config(name, cfg, seed):\n",
        "    set_seed(seed); m = build(name, cfg); L = cfg[\"window\"]\n",
        "    tt, hist = fit(m, L, cfg[\"lr\"], seed)\n",
        "    pv = inv(predict_scaled(m, tens(L, \"val\")[0]))\n",
        "    return dict(model=m, hist=hist, train_time=tt, epochs=len(hist), params=n_params(m), seed=seed, val=metrics(Y_val, pv), val_pred=pv)"
      ]
    },
