        "fig, axs = plt.subplots(1, 2, figsize=(12, 3.6))\n",
        "for ax, (name, cap) in zip(axs, [(\"MLP\", \"hidden\"), (\"CNN\", \"filters\")]):\n",
        "    pv = hpo[hpo.model == name].pivot_table(index=\"window\", columns=cap, values=\"val_MAE\", aggfunc=\"min\")\n",
        "    sns.heatmap(pv, annot=True, fmt=\".2f\", cmap=\"viridis_r\", ax=ax); ax.set_title(f\"{name}: min val MAE (Wh) by window × {cap}\")\n",
        "plt.tight_layout(); plt.savefig(\"results/hpo_heatmaps.png\", dpi=150); plt.show()\n",
        "print(\"Naive val MAE for reference:\", round(BASE_VAL[\"MAE\"], 2))"
