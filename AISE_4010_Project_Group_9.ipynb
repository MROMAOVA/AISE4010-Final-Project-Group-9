      "source": [
        "# Fig 4 / feature selection on TRAIN ONLY: correlation of lagged feature x[t] with target y[t+H]\n",
        "feat_all = [c for c in df.columns if c != \"date\"]\n",
        "corr = {c: np.corrcoef(df[c].values[:n_train-HORIZON], df.Appliances.values[HORIZON:n_train])[0, 1] for c in feat_all}\n",
        "corr = pd.Series(corr).sort_values(key=np.abs, ascending=False)\n",
        "fig, ax = plt.subplots(figsize=(11, 3.8)); corr.plot(kind=\"bar\", ax=ax, color=[\"#E45756\" if c in (\"rv1\",\"rv2\") else \"#4C78A8\" for c in corr.index])\n",
        "ax.set_title(\"Fig 4 — Train-only correlation of x[t] with Appliances[t+H]\"); plt.tight_layout(); plt.savefig(\"results/eda_corr.png\", dpi=150); plt.show()\n",
        "print(\"rv1/rv2 train correlation with target:\", corr[[\"rv1\",\"rv2\"]].round(4).to_dict())\n",
        "\n",
        "# Feature-selection rules (decided from training rows only):\n",
        "#  (1) drop rv1, rv2: documented random variables and |corr| ~ 0  (2) drop any zero-variance train column\n",
        "DROP = [\"rv1\", \"rv2\"] + [c for c in feat_all if df[c].values[:n_train].std() == 0]\n",
        "feat_cols = [c for c in feat_all if c not in DROP]          # 'Appliances' is first -> index 0\n",
        "print(f\"Dropped: {DROP}\\nKept {len(feat_cols)} observed series: {feat_cols}\")"
      ]
    },
