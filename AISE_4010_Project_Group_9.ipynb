      "source": [
        "imputer = SimpleImputer(strategy=\"median\").fit(df.loc[:n_train-1, feat_cols])\n",
        "X_imp = imputer.transform(df[feat_cols])\n",
        "x_scaler = StandardScaler().fit(X_imp[:n_train]);            X_s = x_scaler.transform(X_imp)\n",
        "y_raw = df[\"Appliances\"].values.astype(np.float64)\n",
        "y_scaler = StandardScaler().fit(y_raw[:n_train].reshape(-1, 1)); y_s = y_scaler.transform(y_raw.reshape(-1, 1)).ravel()\n",
        "\n",
        "ts = df[\"date\"]; hr = ts.dt.hour + ts.dt.minute / 60\n",
        "cal = np.column_stack([np.sin(2*np.pi*hr/24), np.cos(2*np.pi*hr/24),\n",
        "                       np.sin(2*np.pi*ts.dt.dayofweek/7), np.cos(2*np.pi*ts.dt.dayofweek/7),\n",
        "                       (ts.dt.dayofweek >= 5).astype(float)]).astype(np.float32)\n",
        "A = np.hstack([X_s, cal]).astype(np.float32)                 # per-timestep features: observed(scaled) + own calendar\n",
        "C = A.shape[1] + cal.shape[1]                                 # + future (target-time) calendar channels\n",
        "print(f\"per-step channels: {len(feat_cols)} observed + {cal.shape[1]} calendar + {cal.shape[1]} future calendar = {C}\")\n",
        "\n",
        "_cache = {}\n",
        "def make_windows(L, lo, hi):\n",
        "    T = np.arange(lo, hi); e = T - HORIZON\n",
        "    assert (e < T).all() and (e - L + 1 >= 0).all()           # leakage guard: inputs strictly precede target\n",
        "    idx = e[:, None] + np.arange(-L + 1, 1)[None, :]\n",
        "    X = np.concatenate([A[idx], np.repeat(cal[T][:, None, :], L, axis=1)], axis=2).astype(np.float32)\n",
        "    return X, y_s[T].astype(np.float32), T\n",
        "def get_data(L):\n",
        "    if L not in _cache:\n",
        "        d = {}\n",
        "        for k, (lo, hi) in splits.items():\n",
        "            X, y, T = make_windows(L, lo, hi); d[k] = dict(X=X, y=y, T=T)\n",
        "        _cache[L] = d\n",
        "    return _cache[L]\n",
        "\n",
        "shape_rows = []\n",
        "for L in LOOKBACKS:\n",
        "    d = get_data(L)\n",
        "    shape_rows.append(dict(window_L=L, **{f\"{k}_X\": tuple(d[k][\"X\"].shape) for k in d}, **{f\"{k}_y\": tuple(d[k][\"y\"].shape) for k in d},\n",
        "                           mlp_input=f\"({L*C},)\", cnn_input=f\"(channels={C}, length={L})\"))\n",
        "display(pd.DataFrame(shape_rows))\n",
        "# identical test instances for every model/window\n",
        "assert all(np.array_equal(get_data(L)[\"test\"][\"T\"], get_data(LOOKBACKS[0])[\"test\"][\"T\"]) for L in LOOKBACKS)\n",
        "assert get_data(LOOKBACKS[0])[\"train\"][\"T\"].max() < get_data(LOOKBACKS[0])[\"val\"][\"T\"].min() < get_data(LOOKBACKS[0])[\"test\"][\"T\"].min()\n",
        "print(\"Test instances identical across windows ✔ ; splits strictly ordered ✔\")"
      ]
    },
