      "source": [
        "# Fig 1: full target series, coloured by split\n",
        "fig, ax = plt.subplots(figsize=(13, 3.6))\n",
        "for k, (lo, hi) in {\"train\": (0, n_train), \"val\": (n_train, n_val_end), \"test\": (n_val_end, n)}.items():\n",
        "    ax.plot(df.date[lo:hi], df.Appliances[lo:hi], lw=0.5, color=cols[k], label=k)\n",
        "ax.set_ylabel(\"Appliances (Wh / 10 min)\"); ax.set_title(\"Fig 1 — Target series with chronological split\"); ax.legend()\n",
        "plt.tight_layout(); plt.savefig(\"results/eda_series.png\", dpi=150); plt.show()\n",
        "\n",
        "# Fig 2: target distribution + daily/weekly profile (train only)\n",
        "tr = df.iloc[:n_train].copy(); tr[\"hour\"] = tr.date.dt.hour; tr[\"dow\"] = tr.date.dt.dayofweek\n",
        "fig, axs = plt.subplots(1, 3, figsize=(15, 3.8))\n",
        "sns.histplot(tr.Appliances, bins=60, ax=axs[0]); axs[0].set_title(\"Fig 2a — Target distribution (train)\\nright-skewed with spikes\")\n",
        "tr.groupby(\"hour\").Appliances.mean().plot(ax=axs[1], marker=\"o\"); axs[1].set_title(\"Fig 2b — Mean by hour of day (train)\"); axs[1].set_ylabel(\"Wh\")\n",
        "tr.groupby(\"dow\").Appliances.mean().plot(kind=\"bar\", ax=axs[2]); axs[2].set_title(\"Fig 2c — Mean by weekday (0=Mon)\"); axs[2].set_ylabel(\"Wh\")\n",
        "plt.tight_layout(); plt.savefig(\"results/eda_profiles.png\", dpi=150); plt.show()\n",
        "\n",
        "# Fig 3: autocorrelation of target (train only)\n",
        "y_tr = df.Appliances.values[:n_train]; yc = y_tr - y_tr.mean()\n",
        "acf = np.array([np.dot(yc[:-k or None], yc[k:]) / np.dot(yc, yc) if k else 1.0 for k in range(0, 2*DAY+1)])\n",
        "fig, ax = plt.subplots(figsize=(11, 3.2)); ax.plot(acf); ax.axvline(DAY, color=\"r\", ls=\"--\", label=\"1 day (144 steps)\")\n",
        "ax.set_xlabel(\"lag (10-min steps)\"); ax.set_ylabel(\"ACF\"); ax.set_title(\"Fig 3 — Target autocorrelation (train). Fast decay, weak daily echo\"); ax.legend()\n",
        "plt.tight_layout(); plt.savefig(\"results/eda_acf.png\", dpi=150); plt.show()"
      ]
