        "# Linear reference (Ridge on the flattened SAME windows); window length and alpha chosen on validation only\n",
        "ridge_rows, best_ridge = [], None\n",
        "for L in LOOKBACKS:\n",
        "    d = get_data(L); Xtr, Xva = d[\"train\"][\"X\"].reshape(len(d[\"train\"][\"X\"]), -1), d[\"val\"][\"X\"].reshape(len(d[\"val\"][\"X\"]), -1)\n",
        "    for a in [1, 10, 100, 1000, 10000]:\n",
        "        t0 = time.time(); m = Ridge(alpha=a).fit(Xtr, d[\"train\"][\"y\"]); tt = time.time() - t0\n",
        "        mv = metrics(Y_val, inv(m.predict(Xva))); ridge_rows.append(dict(window=L, alpha=a, val_MAE=mv[\"MAE\"], val_RMSE=mv[\"RMSE\"], fit_s=tt))\n",
        "        if best_ridge is None or mv[\"MAE\"] < best_ridge[0]: best_ridge = (mv[\"MAE\"], L, a)\n",
        "ridge_df = pd.DataFrame(ridge_rows); display(ridge_df.sort_values(\"val_MAE\").head(5).round(3))\n",
        "_, R_L, R_ALPHA = best_ridge\n",
        "d = get_data(R_L); t0 = time.time()\n",
        "ridge = Ridge(alpha=R_ALPHA).fit(d[\"train\"][\"X\"].reshape(len(d[\"train\"][\"X\"]), -1), d[\"train\"][\"y\"]); ridge_time = time.time() - t0\n",
        "ridge_pred = {s: inv(ridge.predict(d[s][\"X\"].reshape(len(d[s][\"X\"]), -1))) for s in (\"val\", \"test\")}\n",
        "ridge_params = ridge.coef_.size + 1\n",
        "print(f\"Ridge chosen on val: window={R_L}, alpha={R_ALPHA}, params={ridge_params}\")"
      ]
