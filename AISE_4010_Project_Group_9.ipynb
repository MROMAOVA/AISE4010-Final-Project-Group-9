      "source": [
        "n_train = int(TRAIN_FRAC * n); n_val_end = int((TRAIN_FRAC + VAL_FRAC) * n)\n",
        "# A *sample* is indexed by its target time i. Its input window ends at i-HORIZON (strictly earlier).\n",
        "splits = {\"train\": (MAXW + HORIZON - 1, n_train), \"val\": (n_train, n_val_end), \"test\": (n_val_end, n)}\n",
        "rows = []\n",
        "for k, (lo, hi) in splits.items():\n",
        "    rows.append(dict(split=k, first_target=df.date[lo], last_target=df.date[hi-1], n_samples=hi-lo,\n",
        "                     share_pct=round(100*(hi-lo)/n, 1)))\n",
        "split_table = pd.DataFrame(rows); display(split_table)\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(11, 1.8))\n",
        "cols = {\"train\": \"#4C78A8\", \"val\": \"#F58518\", \"test\": \"#54A24B\"}\n",
        "for k, (lo, hi) in splits.items():\n",
        "    ax.barh(0, hi-lo, left=lo, color=cols[k], edgecolor=\"white\")\n",
        "    ax.text((lo+hi)/2, 0, f\"{k.upper()}\\n{df.date[lo].date()} → {df.date[hi-1].date()}\", ha=\"center\", va=\"center\", color=\"white\", fontsize=9, fontweight=\"bold\")\n",
        "ax.set_yticks([]); ax.set_xlabel(\"row index (time →)\"); ax.set_title(\"Chronological split (no shuffling across time)\")\n",
        "plt.tight_layout(); plt.savefig(\"results/split_diagram.png\", dpi=150); plt.show()"
      ]
    },
