      "source": [
        "if QUICK:\n",
        "    GRIDS = {\"MLP\": dict(window=[36], hidden=[64, 128], dropout=[0.0], lr=[1e-3]),\n",
        "             \"CNN\": dict(window=[36], filters=[16, 32], kernel=[3], dropout=[0.2], lr=[1e-3])}\n",
        "else:\n",
        "    GRIDS = {\"MLP\": dict(window=LOOKBACKS, hidden=[64, 128, 256], dropout=[0.0, 0.2], lr=[1e-3, 3e-4]),\n",
        "             \"CNN\": dict(window=LOOKBACKS, filters=[16, 32, 64], kernel=[3, 5], dropout=[0.2], lr=[1e-3, 3e-4])}\n",
        "for k, g in GRIDS.items(): print(k, g, \"->\", int(np.prod([len(v) for v in g.values()])), \"configs\")\n",
        "\n",
        "hpo_rows = []\n",
        "for name, grid in GRIDS.items():\n",
        "    keys = list(grid)\n",
        "    for vals in itertools.product(*[grid[k] for k in keys]):\n",
        "        cfg = dict(zip(keys, vals)); r = run_config(name, cfg, SEED)\n",
        "        hpo_rows.append(dict(model=name, **cfg, val_MAE=r[\"val\"][\"MAE\"], val_RMSE=r[\"val\"][\"RMSE\"], params=r[\"params\"],\n",
        "                             epochs=r[\"epochs\"], train_s=round(r[\"train_time\"], 1), seed=SEED))\n",
        "        print(f\"{name} {cfg} -> val MAE {r['val']['MAE']:.2f} | {r['epochs']} ep | {r['train_time']:.0f}s\")\n",
        "hpo = pd.DataFrame(hpo_rows); hpo.to_csv(\"results/hpo_results.csv\", index=False)\n",
        "BEST = {}\n",
        "for name in GRIDS:\n",
        "    sub = hpo[hpo.model == name].sort_values(\"val_MAE\"); row = sub.iloc[0]\n",
        "    BEST[name] = {k: (row[k].item() if hasattr(row[k], \"item\") else row[k]) for k in GRIDS[name]}\n",
        "    for k in (\"window\", \"hidden\", \"filters\", \"kernel\"):\n",
        "        if k in BEST[name]: BEST[name][k] = int(BEST[name][k])\n",
        "    print(f\"\\n=== {name}: top 5 on validation ===\"); display(sub.head(5).round(3))\n",
        "print(\"\\nBest configurations:\", json.dumps(BEST, indent=1))\n",
        "json.dump(BEST, open(\"results/best_configs.json\", \"w\"), indent=1)"
      ]
    },
