      "source": [
        "## 5. Metrics and baselines\n",
        "All metrics are computed in **original units (Wh)** on the same target indices. *Improvement over baseline* = `(metric_baseline − metric_model) / metric_baseline × 100`, with the **naive last-value** forecast as the baseline."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 7,
      "id": "4019e0b4",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "4019e0b4",
        "outputId": "85e5df73-4ad1-4429-f001-0a428b95014c"
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "Naive (last value)           val MAE=28.42  test MAE=26.65\n",
            "Seasonal naive (t-1 day)     val MAE=60.18  test MAE=53.68\n"
          ]
        }
      ],
      "source": [
        "def metrics(y_true, y_pred):\n",
        "    err = y_pred - y_true\n",
        "    return dict(MAE=np.mean(np.abs(err)), RMSE=np.sqrt(np.mean(err**2)),\n",
        "                sMAPE=100*np.mean(2*np.abs(err)/(np.abs(y_true)+np.abs(y_pred)+1e-8)),\n",
        "                R2=1-np.sum(err**2)/np.sum((y_true-y_true.mean())**2))\n",
        "inv = lambda p: y_scaler.inverse_transform(np.asarray(p).reshape(-1, 1)).ravel()\n",
        "T_val, T_test = get_data(LOOKBACKS[0])[\"val\"][\"T\"], get_data(LOOKBACKS[0])[\"test\"][\"T\"]\n",
        "Y_val, Y_test = y_raw[T_val], y_raw[T_test]\n",
        "\n",
        "base = {}\n",
        "base[\"Naive (last value)\"]      = {s: y_raw[T - HORIZON] for s, T in [(\"val\", T_val), (\"test\", T_test)]}\n",
        "base[\"Seasonal naive (t-1 day)\"] = {s: y_raw[T - DAY]     for s, T in [(\"val\", T_val), (\"test\", T_test)]}\n",
        "for k, v in base.items():\n",
        "    print(f\"{k:28s} val MAE={metrics(Y_val, v['val'])['MAE']:.2f}  test MAE={metrics(Y_test, v['test'])['MAE']:.2f}\")\n",
        "NAIVE = \"Naive (last value)\"\n",
        "BASE_VAL, BASE_TEST = metrics(Y_val, base[NAIVE][\"val\"]), metrics(Y_test, base[NAIVE][\"test\"])"
      ]
    },
